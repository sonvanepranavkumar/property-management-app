@model IEnumerable<Property>

<h1>Properties</h1>

<a asp-action="Create" class="btn btn-primary mb-4">Add Property</a>

<div class="row">
    @foreach (var property in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@property.Address</h5>

                    <p class="card-text">
                        <strong>Rent:</strong> £@property.Rent.ToString("N2")
                    </p>

                    <p class="card-text">
                        <strong>Occupancy Status:</strong> @property.Status
                    </p>

                    @if (property.Tenants.Any())
                    {
                        <h6>Tenants</h6>

                        <ul>
                            @foreach (var tenant in property.Tenants)
                            {
                                <li>@tenant.FirstName @tenant.LastName</li>
                            }
                        </ul>
                    }

                    <div class="mt-3">
                        <a asp-action="ManageTenants"
                           asp-route-id="@property.Id"
                           class="btn btn-info">
                            Manage Tenants
                        </a>

                        <a asp-controller="RentPayment"
                           asp-action="Index"
                           asp-route-propertyId="@property.Id"
                           class="btn btn-primary">
                            Rent Payments
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@property.Id"
                           class="btn btn-primary">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@property.Id"
                              method="post">

                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this property and all of its tenants?');">
                                Delete
                            </button>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>