@model Tenant

<h1>Edit Tenant</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PropertyId" />

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LeaseStartDate" class="form-label"></label>
        <input asp-for="LeaseStartDate" class="form-control" type="date" />
        <span asp-validation-for="LeaseStartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LeaseEndDate" class="form-label"></label>
        <input asp-for="LeaseEndDate" class="form-control" type="date" />
        <span asp-validation-for="LeaseEndDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>

    <a asp-controller="Tenant"
       asp-action="Index"
       asp-route-propertyId="@Model.PropertyId"
       class="btn btn-secondary">
        Cancel
    </a>

</form>