@model Tenant

<h1>Add Tenant</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" name="propertyId" value="@ViewBag.PropertyId" />

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LeaseStartDate" class="form-label"></label>
        <input asp-for="LeaseStartDate" class="form-control" type="date" />
        <span asp-validation-for="LeaseStartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LeaseEndDate" class="form-label"></label>
        <input asp-for="LeaseEndDate" class="form-control" type="date" />
        <span asp-validation-for="LeaseEndDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add Tenant</button>

    <a asp-controller="Property"
       asp-action="ManageTenants"
       asp-route-id="@ViewBag.PropertyId"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}