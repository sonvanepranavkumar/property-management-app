@model List<Tenant>

<h1>Tenants</h1>

<hr />

@if (Model.Any())
{
    foreach (var tenant in Model)
    {
        <div class="card mb-3">
            <div class="card-body">

                <h5 class="card-title">
                    @tenant.FirstName @tenant.LastName
                </h5>

                <p>
                    <strong>Email:</strong>
                    @tenant.Email
                </p>

                @if (!string.IsNullOrEmpty(tenant.Phone))
                {
                    <p>
                        <strong>Phone:</strong>
                        @tenant.Phone
                    </p>
                }

                <p>
                    <strong>Lease Start:</strong>
                    @tenant.LeaseStartDate.ToString("dd/MM/yyyy")
                </p>

                <p>
                    <strong>Lease End:</strong>
                    @(tenant.LeaseEndDate.HasValue ? tenant.LeaseEndDate.Value.ToString("dd/MM/yyyy") : "Ongoing")
                </p>

                <a asp-action="Edit"
                   asp-route-id="@tenant.Id"
                   class="btn btn-primary">
                    Edit
                </a>

                <form asp-action="Delete"

                      asp-route-id="@tenant.Id"
                      method="post"
                      class="d-inline">

                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Are you sure you want to delete this tenant?');">
                        Delete
                    </button>

                </form>
            </div>
        </div>
    }
}

<a asp-action="Create"
   asp-route-propertyId="@ViewBag.PropertyId"
   class="btn btn-primary">
    Add Tenant
</a>

<a asp-controller="Property"
   asp-action="Index"
   class="btn btn-secondary">
    Back to Properties
</a>
