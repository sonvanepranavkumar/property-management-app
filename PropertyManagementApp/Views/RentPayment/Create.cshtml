@model RentPayment

<h1>Rent Payments</h1>

<form asp-action="Create" method="post">

    <input type="hidden" name="PropertyId" value="@ViewBag.PropertyId" />
    <input type="hidden" name="Status" value="Pending" />

    <div class="mb-3">
        <label asp-for="TenantName" class="form-label"></label>

        <select asp-for="TenantName" class="form-control">
            <option value="">Select tenant</option>

            @foreach (var tenant in ViewBag.Tenants)
            {
                <option value="@($"{tenant.FirstName} {tenant.LastName}")">
                    @tenant.FirstName @tenant.LastName
                </option>
            }
        </select>

        <span asp-validation-for="TenantName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" class="form-control" type="date" />
        <span asp-validation-for="DueDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create Rent Payment
    </button>

</form>
