@model Expense

<h1>Create Expense</h1>

<form asp-action="Create" method="post">

    <input type="hidden" name="PropertyId" value="@ViewBag.PropertyId" />

    <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ExpenseDate" class="form-label"></label>
        <input asp-for="ExpenseDate" class="form-control" type="date" />
        <span asp-validation-for="ExpenseDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create Expense
    </button>

</form>
